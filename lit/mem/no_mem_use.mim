// RUN: not %mim -p opt %s -p ll -o - 2>&1 | %FileCheck %s

plugin core;

lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %compile.named "%mem.mem_linearity",
        _default_compile(),
    );

con extern main(mem: %mem.M 0, argc: I32, argv: %mem.Ptr («⊤:Nat; %mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [I32]) =
    let (mem_al, ptr) = %mem.alloc (I32, 0) mem;
    let mem_st        = %mem.store (mem_al, ptr, argc);
    let (mem_lo, val) = %mem.load (mem_st, ptr);

    return (val);

// CHECK: Error: linear mem variable is not consumed in lambda
