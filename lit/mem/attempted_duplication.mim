// RUN: not %mim -p opt %s -p ll -o - 2>&1 | %FileCheck %s

plugin core;
plugin compile;
plugin mem;
plugin opt;

extern lam _compile(): compile.Phase =
    compile.phases ff (
        mem.mem_linearity,
        opt._default_compile(),
    );

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [(mem.M 0) ∪ ((mem.M 0) ∪ I32), I32]) =
    let bundle = (m, argc);

    let cond = core.icmp.ul (argc, 3I32);
    let joined = (m, bundle#cond)#(cond);
    return (joined, argc);

// CHECK: error: attempted reuse of linear object `m`
