// RUN: not %mim -p opt %s -p ll -o - 2>&1 | %FileCheck %s

plugin core;
plugin compile;
plugin mem;
plugin opt;

extern lam _compile(): compile.Phase =
    compile.phases ff (
        mem.mem_linearity,
        opt._default_compile(),
    );

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    let (m_al, ptr) = mem.alloc (I32, 0) m;
    let m_st         = mem.store (m_al, ptr, argc);
    let (m_lo, val)  = mem.load (m_al, ptr);
    let m_fin1       = mem.free(m_st, ptr);
    let m_fin2       = mem.free(m_lo, ptr);

    let cond = core.icmp.ul (argc, 3I32);
    let joined = (m_fin2, m_fin1)#(cond);
    return (joined, val);

// CHECK: attempted reuse of linear object `_5009#ff`
