// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o -
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 1
// RUN: %t 1 2 3; test $? -eq 4
// RUN: %t 1 2 3 4 5; test $? -eq 6

plugin core;
plugin compile;
plugin mem;
plugin opt;

extern lam _compile(): compile.Phase =
    compile.phases ff (
        mem.mem_linearity,
        opt._default_compile(),
    );

con return_from_nested(bundle: [[mem.M 0, mem.Ptr(I32, 0)], I32], return: Cn [mem.M 0, I32]) =
    let ((m_al, ptr), val) = bundle;
    let m_st        = mem.store (m_al, ptr, val);
    let (m_lo, res) = mem.load (m_st, ptr);
    let m_fin       = mem.free (m_lo, ptr);
    return (m_fin, res);

extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    let al = mem.alloc (I32, 0) m;
    let bundle = (al, argc);
    return_from_nested (bundle, return);
