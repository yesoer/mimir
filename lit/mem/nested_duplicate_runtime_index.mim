// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o -
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 1
// RUN: %t 1 2 3; test $? -eq 4
// RUN: %t 1 2 3 4 5; test $? -eq 6

plugin core;
plugin compile;
plugin mem;
plugin opt;

extern lam _compile(): compile.Phase =
    compile.phases ff (
        mem.mem_linearity,
        opt._default_compile(),
    );

// use is so the bundle is not immediately destructured, which is what happens
// when we pass it to return directly
con return_elem(bundle: [mem.M 0, I32], return: Cn [mem.M 0, I32]) =
    return bundle;

// the idea behind this test is to verify that we can correctly detect
// duplicates in tuples, where we have to mark each element as used because of
// runtime indexing
extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    let argc_1 = core.wrap.add 0 (argc, 1I32);
    let bundle = ((m, argc), (m, argc_1));

    let idx = core.icmp.ul (argc, 3I32);

    return_elem (bundle#idx, return);
