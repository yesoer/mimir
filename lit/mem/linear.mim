// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o -
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 1
// RUN: %t 1 2 3; test $? -eq 4
// RUN: %t 1 2 3 4 5; test $? -eq 6

plugin core;

lam extern _compile(): %compile.Phase =
    %compile.phases ff (
        %compile.named "%mem.mem_linearity",
        _default_compile(),
    );

con extern main(mem: %mem.M 0, argc: I32, argv: %mem.Ptr («⊤:Nat; %mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [%mem.M 0, I32]) =
    let (mem_al, ptr) = %mem.alloc (I32, 0) mem;
    let mem_st        = %mem.store (mem_al, ptr, argc);
    let (mem_lo, val) = %mem.load (mem_st, ptr);
    let mem_fin       = %mem.free (mem_lo, ptr);
    return (mem_fin, val);
